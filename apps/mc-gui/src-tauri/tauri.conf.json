{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustEli5",
  "version": "0.1.0",
  "identifier": "dev.rgdevment.justeli5",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JustEli5",
        "width": 920,
        "height": 860,
        "minWidth": 640,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/eli5"
    ],
    "publisher": "rgdevment",
    "shortDescription": "Graba reuniones y escribe la minuta",
    "longDescription": "Lee los subtítulos de Teams, Zoom, Meet y Slack, graba el audio y escribe la minuta con IA.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RTcwOTBBQTY2QUUxQzgKUldUSTRXcW1DZ25uRnZUekhxbStFcWFGZDJVRjlFMklSZHNFSm1mc0g0ZDVscGdvNWR6eE9pc0MK",
      "endpoints": [
        "https://raw.githubusercontent.com/rgdevment/JustEli5/manifest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
